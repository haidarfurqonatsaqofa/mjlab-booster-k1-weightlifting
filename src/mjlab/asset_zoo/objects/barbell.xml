<mujoco model="barbell">
  <worldbody>
    <body name="barbell" pos="0 0 0">
      <freejoint name="barbell_freejoint"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.015 0.015 0.001"/>

      <!-- Batang barbel (panjang 60 cm, diameter 12 mm) -->
      <geom name="bar_shaft" type="capsule" fromto="0 -0.30 0 0 0.30 0" size="0.006" rgba="0.25 0.25 0.28 1"/>

      <!-- Cakram beban kiri & kanan (diameter 12 cm / radius 0.06 m sesuai CD standar FIRA) -->
      <geom name="plate_left" type="cylinder" fromto="0 -0.26 0 0 -0.23 0" size="0.06" rgba="0.85 0.12 0.12 1"/>
      <geom name="plate_right" type="cylinder" fromto="0 0.23 0 0 0.26 0" size="0.06" rgba="0.85 0.12 0.12 1"/>
    </body>
  </worldbody>
</mujoco>